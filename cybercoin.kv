<Coin>:
    size_hint: None, None
    size: 0.778 * (self.parent.design_min if self.parent else 360), 0.778 * (self.parent.design_min if self.parent else 360)
    pos: (self.parent.width/2 - self.width/2 + 0.00833 * (self.parent.design_min if self.parent else 360), self.parent.height/2 - self.height/2) if self.parent else (0, 0)
    canvas.before:
        PushMatrix
        Scale:
            x: self.tilt_scale_x
            y: self.tilt_scale_y
            origin: self.center
    canvas:
        Color:
            rgba: 1, 1, 1, 1 
        Rectangle:
            pos: self.pos
            size: self.size
            texture: root.coin_texture  
    canvas.after:
        PopMatrix

<CyberCoinRoot>:
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
            texture: root.bg_texture

    # Flip-It Logo (380×180 ref at 360-wide design)
    Image:
        size_hint: None, None
        size: min(root.width * 0.98, 1.055 * root.design_min), min(root.width * 0.98, 1.055 * root.design_min) * (180. / 380.)
        fit_mode: "contain"
        pos: (root.width/2 - self.width/2, coin.top - 0.208 * root.design_min)
        texture: root.logo_tex

    # SIGNATUR
    Image:
        size_hint: None, None
        size: 0.25 * root.design_min, 0.125 * root.design_min
        pos_hint: {'x': 0.05, 'y': 0.05}
        fit_mode: "contain"
        texture: root.sign_tex

    Coin:
        id: coin

    # BACKGROUND BUTTON
    Button:
        size_hint: None, None
        size: 0.236 * root.design_min, 0.236 * root.design_min
        pos_hint: {'top': 0.98, 'right': 0.98} 
        background_color: 0, 0, 0, 0
        on_release: root.next_background()
        canvas.before:
            PushMatrix
            Scale:
                x: 0.85 if self.state == 'down' else 1.0
                y: 0.85 if self.state == 'down' else 1.0
                origin: self.center
            Color:
                rgba: 1, 1, 1, 1
            Rectangle:
                pos: self.pos
                size: self.size
                texture: root.btn_bg_tex
        canvas.after:
            PopMatrix

    # MODE BUTTON
    Button:
        size_hint: None, None
        size: 0.361 * root.design_min, 0.208 * root.design_min
        pos_hint: {'right': 0.98, 'y': 0.03} 
        background_color: 0, 0, 0, 0
        on_release: root.toggle_mode()
        canvas.before:
            PushMatrix
            Scale:
                x: 0.9 if self.state == 'down' else 1.0
                y: 0.9 if self.state == 'down' else 1.0
                origin: self.center
            Color:
                rgba: 1, 1, 1, 1
            Rectangle:
                pos: self.pos
                size: self.size
                texture: root.btn_mode_tex
        canvas.after:
            PopMatrix